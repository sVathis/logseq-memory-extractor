{
  "description": "Shared Logseq memory extraction and semantic retrieval for Codex.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__LOGSEQ_PYTHON__ __LOGSEQ_BIN__/logseq_memory_codex.py enqueue",
            "timeout": 3,
            "statusMessage": "Saving reusable task memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__LOGSEQ_PYTHON__ __LOGSEQ_BIN__/logseq_memory_retriever.py",
            "timeout": 10,
            "statusMessage": "Searching Logseq memory",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
